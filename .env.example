# Copy to .env and fill in. Every provider is optional; nyxOS degrades gracefully.
ANTHROPIC_API_KEY=
# Claude: the fast model handles each request first and escalates to CLAUDE_MODEL when needed.
CLAUDE_FAST_MODEL=claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

CARTESIA_API_KEY=
CARTESIA_VOICE_ID=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4
CARTESIA_MODEL=sonic-3.6

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# cartesia | elevenlabs | say   (say = macOS built-in, offline, zero latency)
TTS_PROVIDER=cartesia
# cartesia | elevenlabs
STT_PROVIDER=cartesia

# Global push-to-talk toggle (Electron accelerator syntax)
HOTKEY_LISTEN=Alt+Space
HOTKEY_COMMAND=Alt+Shift+Space

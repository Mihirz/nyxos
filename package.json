{
  "name": "callbacks",
  "version": "0.1.0",
  "private": true,
  "description": "Voice + keystroke operator for blind and low-vision computer users. You drive; it's your hands and eyes.",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/core/*.test.ts",
    "demo:site": "node demo/serve.mjs",
    "bridge:install": "bash scripts/install-vscode-bridge.sh"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.31.0",
    "@mozilla/readability": "^0.6.0",
    "dotenv": "^18.0.9",
    "linkedom": "^0.18.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
